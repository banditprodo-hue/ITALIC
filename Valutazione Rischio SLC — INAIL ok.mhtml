:22px; background:var(--conn); transform:translateX(50%);"></div>
    <div style=3D"position:absolute; left:25%; bottom:0; transform:translat=
eX(-50%); width:0;height:0;border-left:7px solid transparent;border-right:7=
px solid transparent;border-top:9px solid var(--conn);"></div>
    <div style=3D"position:absolute; right:25%; bottom:0; transform:transla=
teX(50%); width:0;height:0;border-left:7px solid transparent;border-right:7=
px solid transparent;border-top:9px solid var(--conn);"></div>
    <div style=3D"position:absolute; left:25%; top:0; transform:translateX(=
-120%); font-size:0.68rem; font-weight:700; color:#1A6B30; letter-spacing:0=
.05em;">S=C3=8C =E2=9C=93</div>
    <div style=3D"position:absolute; right:25%; top:0; transform:translateX=
(120%); font-size:0.68rem; font-weight:700; color:#8B1A1A; letter-spacing:0=
.05em;">NO =E2=9C=97</div>
  </div>

  <!-- =E2=95=90=E2=95=90=E2=95=90=E2=95=90=E2=95=90=E2=95=90=E2=95=90 RAMI=
 =E2=95=90=E2=95=90=E2=95=90=E2=95=90=E2=95=90=E2=95=90=E2=95=90 -->
  <div class=3D"branch-row">

    <!-- RAMO S=C3=8C -->
    <div class=3D"branch-col">
      <div class=3D"block c-trsc">
        <div class=3D"badge">=E2=9C=93 RISCHIO TRASCURABILE</div>
        <div class=3D"title">Conclusione Fase Preliminare</div>
        <div class=3D"sub">Inserimento risultati nel DVR</div>
        <div class=3D"mod-note">=E2=9C=8E Rinominato: il processo non si ch=
iude definitivamente =E2=80=94 avvia il monitoraggio periodico</div>
        <div class=3D"roles" style=3D"margin-top:8px">=E2=97=8F DL approva =
e firma</div>
      </div>
      <div class=3D"conn"><div class=3D"conn-line gap-m"></div><div class=
=3D"conn-arrow"></div></div>
      <div class=3D"monitor-block">
        <div class=3D"fase-label">Nuovo =E2=80=94 Monitoraggio</div>
        <div class=3D"title">Monitoraggio Periodico</div>
        <ul>
          <li>Verifica efficacia nel tempo</li>
          <li>Rivalutazione ogni 2=E2=80=933 anni</li>
          <li>Rivalutazione anticipata dopo cambiamenti organizzativi signi=
ficativi</li>
        </ul>
        <div class=3D"roles">=E2=97=8F RSPP pianifica &nbsp;=E2=97=8F DL ap=
prova</div>
      </div>
      <div class=3D"branch-fill"></div>
      <div class=3D"conn"><div class=3D"conn-line gap-m"></div><div class=
=3D"conn-arrow"></div></div>
    </div>

    <!-- RAMO NO -->
    <div class=3D"branch-col">
      <div class=3D"block c-appr">
        <div class=3D"badge">=E2=9C=97 FASE APPROFONDITA</div>
        <div class=3D"title">Valutazione Approfondita</div>
        <div class=3D"sub">Strumento Indicatore (35 item)</div>
        <div class=3D"mod-note">=E2=9C=8E Ampliato: pu=C3=B2 includere ques=
tionari, focus group e interviste semi-strutturate (cfr. linee guida INAIL)=
</div>
        <div class=3D"roles" style=3D"margin-top:8px">=E2=97=8F Lavoratori =
compilano ANONIMO<br>=E2=97=8F RSPP somministra e raccoglie</div>
      </div>
      <!-- freccia continua verso Fase 5 -->
      <div class=3D"branch-fill" style=3D"display:flex; flex-direction:colu=
mn; align-items:center; width:100%; flex:1; min-height:22px;">
        <div style=3D"width:3px; flex:1; background:var(--conn); min-height=
:22px;"></div>
      </div>
      <div style=3D"width:0;height:0;border-left:7px solid transparent;bord=
er-right:7px solid transparent;border-top:9px solid var(--conn);"></div>
    </div>

  </div>

  <!-- merge line from both branches into fase 5 -->
  <div style=3D"width:100%; position:relative; height:28px; margin-top:0;">
    <!-- linea sinistra dal ramo S=C3=8C -->
    <div style=3D"position:absolute; left:25%; top:0; width:3px; height:14p=
x; background:var(--conn); transform:translateX(-50%);"></div>
    <!-- linea destra dal ramo NO -->
    <div style=3D"position:absolute; right:25%; top:0; width:3px; height:14=
px; background:var(--conn); transform:translateX(50%);"></div>
    <!-- barra orizzontale di giunzione -->
    <div style=3D"position:absolute; left:25%; right:25%; top:14px; height:=
3px; background:var(--conn);"></div>
    <!-- discesa centrale -->
    <div style=3D"position:absolute; left:50%; top:14px; width:3px; height:=
14px; background:var(--conn); transform:translateX(-50%);"></div>
    <!-- freccia centrale -->
    <div style=3D"position:absolute; left:50%; bottom:0; transform:translat=
eX(-50%); width:0;height:0;border-left:7px solid transparent;border-right:7=
px solid transparent;border-top:9px solid var(--conn);"></div>
  </div>

  <!-- =E2=95=90=E2=95=90=E2=95=90=E2=95=90=E2=95=90=E2=95=90=E2=95=90 FASE=
