<body>

<div class=3D"page-title" id=3D"page-title-block" data-date=3D"13 maggio 20=
26">
  <h1>Valutazione Rischio Stress Lavoro-Correlato (SLC)</h1>
</div>


<div class=3D"layout">
<div class=3D"flow">

  <!-- START -->
  <div class=3D"pill">Avvio Processo =E2=80=94 Valutazione Stress Lavoro-Co=
rrelato</div>

  <div class=3D"conn"><div class=3D"conn-line gap-m"></div><div class=3D"co=
nn-arrow"></div></div>

  <!-- FASE 1 -->
  <div class=3D"block c-dl">
    <span class=3D"fase-label">Fase 1 =E2=80=94 Propedeutica</span>
    <div class=3D"title">Costituzione del Gruppo di Gestione</div>
    <div class=3D"roles"><span>=E2=97=8F DL delega</span><span>=E2=97=8F RS=
PP coordina</span></div>
  </div>

  <div class=3D"conn"><div class=3D"conn-line gap-m"></div><div class=3D"co=
nn-arrow"></div></div>

  <!-- FASE 2 -->
  <div class=3D"block c-rspp">
    <span class=3D"fase-label">Fase 2</span>
    <div class=3D"title">Identificazione Gruppi Omogenei</div>
    <div class=3D"sub">Reparto, mansione, turno, modalit=C3=A0</div>
    <div class=3D"roles"><span>=E2=97=8F RSPP guida</span><span>=E2=97=8F R=
LS consultato</span></div>
  </div>

  <div class=3D"conn"><div class=3D"conn-line gap-m"></div><div class=3D"co=
nn-arrow"></div></div>

  <!-- FASE 3 -->
  <div class=3D"block c-rspp">
    <span class=3D"fase-label">Fase 3 =E2=80=94 Preliminare</span>
    <div class=3D"title">Compilazione Lista di Controllo INAIL</div>
    <div class=3D"sub">Per ogni gruppo omogeneo identificato</div>
    <div class=3D"roles">=E2=97=8F RSPP / ASPP compila</div>
  </div>

  <div class=3D"conn"><div class=3D"conn-line gap-m"></div><div class=3D"co=
nn-arrow"></div></div>

  <!-- THREE AREAS -->
  <div class=3D"areas-row">
    <div class=3D"area-block c-sent">
      <div class=3D"area-label">Area A</div>
      <div class=3D"area-title">Eventi Sentinella</div>
      <ul><li>Assenze malattia</li><li>Infortuni</li><li>Turnover</li><li>S=
anzioni</li></ul>
      <div class=3D"roles">=E2=97=8F Medico Competente<br>fornisce dati san=
itari</div>
    </div>
    <div class=3D"area-block c-cont">
      <div class=3D"area-label">Area B</div>
      <div class=3D"area-title">Contenuto del Lavoro</div>
      <ul><li>Ambiente e attrezzature</li><li>Carichi di lavoro</li><li>Rit=
mi e turni</li><li>Competenze vs mansioni</li></ul>
      <div class=3D"roles">=E2=97=8F RSPP raccoglie<br>=E2=97=8F RLS contri=
buisce</div>
    </div>
    <div class=3D"area-block c-ctx">
      <div class=3D"area-label">Area C</div>
      <div class=3D"area-title">Contesto del Lavoro</div>
      <ul><li>Chiarezza ruolo</li><li>Autonomia</li><li>Supporto superiore<=
/li><li>Rapporti colleghi</li><li>Gestione cambiamento</li></ul>
      <div class=3D"roles">=E2=97=8F RSPP &nbsp;=E2=97=8F RLS</div>
    </div>
  </div>

  <div class=3D"conn"><div class=3D"conn-line gap-m"></div><div class=3D"co=
nn-arrow"></div></div>

  <!-- FASE 4 -->
  <div class=3D"block c-neut">
    <span class=3D"fase-label">Fase 4</span>
    <div class=3D"title">Calcolo Punteggio e Fascia di Rischio</div>
    <div class=3D"sub">Per ogni gruppo omogeneo</div>
    <div class=3D"roles">=E2=97=8F RSPP calcola</div>
  </div>

  <div class=3D"conn"><div class=3D"conn-line gap-m"></div><div class=3D"co=
nn-arrow"></div></div>

  <!-- DIAMOND -->
  <div class=3D"diamond-outer">
    <div class=3D"diamond" role=3D"img" aria-label=3D"Decisione: il rischio=
 =C3=A8 non rilevante o le misure correttive sono efficaci?">
      <div class=3D"diamond-inner">
        <div class=3D"d-title">Rischio<br>non rilevante?</div>
        <div class=3D"d-sub">o misure<br>correttive<br>efficaci?</div>
      </div>
    </div>
  </div>

  <div class=3D"conn"><div class=3D"conn-line gap-s"></div></div>

  <!-- =E2=95=90=E2=95=90=E2=95=90=E2=95=90=E2=95=90=E2=95=90=E2=95=90 FORK=
